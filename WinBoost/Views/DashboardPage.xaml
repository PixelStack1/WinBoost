<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinBoost.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="28,20" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextBlockStyle}" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="AppliedLabel" Opacity="0.7" />
                        <TextBlock x:Name="AppliedValue" FontSize="40" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppliedNative" FontSize="13" Opacity="0.75" />
                        <ProgressBar x:Name="AppliedBar" Maximum="100" Foreground="{StaticResource BoostAccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="PendingLabel" Opacity="0.7" />
                        <TextBlock x:Name="PendingValue" FontSize="40" FontWeight="SemiBold" />
                        <TextBlock x:Name="RebootText" TextWrapping="Wrap" Foreground="#FFF5A623" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="RiskLabel" Opacity="0.7" />
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Border Style="{StaticResource BadgeStyle}" Background="#FF2EC27E"><TextBlock x:Name="SafeBadge" FontSize="12" Foreground="Black" /></Border>
                            <Border Style="{StaticResource BadgeStyle}" Background="#FFF5A623"><TextBlock x:Name="CautionBadge" FontSize="12" Foreground="Black" /></Border>
                            <Border Style="{StaticResource BadgeStyle}" Background="#FFE84855"><TextBlock x:Name="DangerBadge" FontSize="12" Foreground="White" /></Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="MonTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                                <TextBlock x:Name="GameStatusText" Text="{x:Bind VM.GameStatus, Mode=OneWay}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="GaugeGrid" ColumnSpacing="24" Padding="8,12" MaxWidth="820" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock x:Name="MonHint" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#557C4DFF" Offset="0" />
                        <GradientStop Color="#1500C2FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="GamingTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="GamingDesc" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                    <Button x:Name="GamingButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Padding="24,12"
                            VerticalAlignment="Center" Click="OnGamingClick" IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7FC;" />
                            <TextBlock x:Name="GamingButtonText" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="ActivityLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <HyperlinkButton x:Name="ClearButton" HorizontalAlignment="Right" Click="OnClearClick" Padding="4,0" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind VM.Log}" Height="260" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
