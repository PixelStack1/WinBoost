<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinBoost.Views.BoostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WinBoost.Services"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="28,20" Spacing="16" MaxWidth="1100">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SubText" Opacity="0.7" TextWrapping="Wrap" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WatchTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="WatchDesc" Opacity="0.7" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="WatchToggle" Toggled="OnWatchToggled" />
                        <TextBlock Text="{x:Bind VM.GameStatus, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="BuiltInText" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBox x:Name="CustomGamesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" FontFamily="Cascadia Mono, Consolas" />
                        <Button x:Name="SaveGamesButton" Click="OnSaveGamesClick" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PrioTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="PrioDesc" Opacity="0.7" TextWrapping="Wrap" />
                        <ListView x:Name="AppsList" Height="320" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:RunningApp">
                                    <StackPanel Padding="0,4">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="{x:Bind ProcessName}" /><Run Text=" · " /><Run Text="{x:Bind MemoryText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HighButton" Style="{StaticResource AccentButtonStyle}" Click="OnHighClick" />
                            <Button x:Name="NormalButton" Click="OnNormalClick" />
                            <Button x:Name="RescanButton1" Click="OnRescanClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="BgTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="BgDesc" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock x:Name="AutoCloseHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <ListView x:Name="BgList" Height="320" SelectionMode="Multiple" SelectionChanged="OnBgSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:RunningApp">
                                    <StackPanel Padding="0,4">
                                        <TextBlock Text="{x:Bind ProcessName}" />
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="{x:Bind Title}" /><Run Text=" · " /><Run Text="{x:Bind MemoryText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CloseButton" Style="{StaticResource AccentButtonStyle}" Click="OnCloseClick" />
                            <Button x:Name="RescanButton2" Click="OnRescanClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
