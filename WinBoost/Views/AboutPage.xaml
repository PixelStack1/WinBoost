<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinBoost.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="28,20" Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Padding="28">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image x:Name="Logo" Width="72" Height="72" />
                        <StackPanel>
                            <TextBlock x:Name="NameText" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock x:Name="ByText" FontSize="16" Foreground="{StaticResource BoostAccentBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Opacity="0.7" />
                    <TextBlock x:Name="TaglineText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="DescText" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock x:Name="SafetyText" TextWrapping="Wrap" Foreground="#FF2EC27E" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="LogButton" Click="OnLogClick" />
                        <Button x:Name="BackupsButton" Click="OnBackupsClick" />
                    </StackPanel>
                    <TextBlock x:Name="CopyText" Opacity="0.5" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
